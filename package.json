{
  "name": "kazikwanza",
  "private": true,
  "version": "0.1.0",
  "description": "Do the work first. Then scroll. Earn scrolls and screen time by finishing verified tasks.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:supabase": "node scripts/build-supabase.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.2",
    "@fontsource/inter": "5.1.0",
    "@supabase/realtime-js": "2.118.0",
    "idb-keyval": "6.2.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "esbuild": "0.21.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
